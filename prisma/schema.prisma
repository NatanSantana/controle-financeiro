// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {

  idUser        Int         @id @default(autoincrement())
  senha         String
  nome          String      
  telefone      String      @unique
  email         String      @unique
  rendaMensal   Int         @default(0)  

  gastos      Gastos[]

  gastosFixos GastosFixos[]

  categoriaGasto CategoriasGasto[]

  @@map("user")
}

model Gastos {
  
    idGastos    Int        @id @default(autoincrement())
    valor       Decimal    @db.Decimal(10, 2)
    descricao   String?
    idUser      Int
    user        User       @relation(fields: [idUser], references: [idUser])
    dataCompra  DateTime?

    idCategoria     Int?
    categoriaGasto  CategoriasGasto? @relation(fields: [idCategoria], references: [idCategoria])


  @@map("gastos")
}

model GastosFixos {
  id          Int     @id @default(autoincrement())
  valor       Decimal @db.Decimal(10, 2)
  descricao   String
  idUser      Int
  user        User    @relation(fields: [idUser], references: [idUser])

  @@map("gastosFixos")

}

model CategoriasGasto {
  idCategoria Int     @id @default(autoincrement())
  nome        String

  idUser      Int
  user        User    @relation(fields: [idUser], references: [idUser])

  gastos Gastos[]
  @@map("categoriaGasto")
}